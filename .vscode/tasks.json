{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server (Codespace)",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "0.0.0.0"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}